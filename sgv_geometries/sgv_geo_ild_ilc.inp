      LAYER : TPC
         REPEAT : TIMES=25, DELTA_R=5.44
C             R is the edge of the first pad. max R should be
C             171.5, 227 pads 6 mm. rad length is 1.155205835e-05
C             mm. Here I do 25 rows (group 227 by 9). The first
C             row middle is at 38.1, the last at 168.7
C       exact details dixit full sim:
C       vessel: 32.9 to 176.98   z=235.0
C       walls 2.5 and 5.5
C       endplate etc 12.5
C       service areas : 1.81
C       edge first/last pad: 34.4/171.5 -> len = 136.1 -> ~ 226.8 padrows of 0.6
C       226.8/9.07 ~ 25, 9.07*0.6=5.44
C
C

            GEOMETRY:  R=38.1  , ZMIN=0.0, ZMAX=222.5
            MATERIAL:    X0=0.00047
            MEASUREMENT: CODE=1, SIG_RPHI=0.00301, SIG_Z=0.09,
                          SIG_RPHI_SLOPE=-0.0000058
         ENDREPEAT :

      LAYER : TPC-OWALL
            GEOMETRY:  R=177. , ZMIN=0.0, ZMAX=235.0
            MATERIAL:    X0=.0200082718,  A=6
            MEASUREMENT: CODE=0


