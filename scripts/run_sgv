#!/usr/bin/env bash
# Run SGV (usesgvlcio.exe) in a work directory prepared by sgv.py.
# Only sets up the environment; steering, geometry and input are handled in sgv.py.
# Usage: run_sgv <work_dir>
set -eo pipefail

[[ $# -ne 1 ]] && { echo "Usage: $0 <work_dir>"; exit 1; }

SGV_DIR=${SGV_DIR:-/data/dust/user/schwanvl/promotion/code/SGV_install/sgv}

# SGV is linked against LCIO/ROOT of this key4hep release
[[ -z "${KEY4HEP_STACK:-}" ]] && source /cvmfs/sw.hsf.org/key4hep/setup.sh -r 2026-04-08 > /dev/null
source "$SGV_DIR/sgvenv.sh"

cd "$1"
echo "Starting SGV at $(date) in $PWD"
./usesgvlcio.exe
echo "Finished SGV at $(date)"
